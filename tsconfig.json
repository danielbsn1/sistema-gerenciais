{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": "./resources/ts/",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "resources/ts/**/*"
  ]
}